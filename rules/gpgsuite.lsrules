{
  "name": "GPG Suite",
  "description": "Rules for GPG Suite - OpenPGP encryption and signing tools for macOS.",
  "rules": [
    {
      "action": "allow",
      "process": "/Applications/GPG Keychain.app/Contents/MacOS/GPG Keychain",
      "remote-domains": [
        "gpgtools.com",
        "openpgp.org"
      ],
      "protocol": "tcp",
      "ports": "443"
    },
    {
      "action": "allow",
      "process": "/Library/Application Support/GPGTools/GPGSuite_Updater.app/Contents/MacOS/GPGSuite_Updater",
      "remote-domains": [
        "gpgtools.com",
        "gpgtools.org"
      ],
      "protocol": "tcp",
      "ports": "443"
    }
  ]
}
