{
  "name": "Arq",
  "description": "Rules for Arq - Cloud backup software for Mac and Windows.",
  "rules": [
    {
      "action": "allow",
      "process": "/Applications/Arq.app/Contents/MacOS/Arq",
      "remote-domains": [
        "live.com",
        "microsoft.com",
        "microsoftonline.com",
        "msftauth.net"
      ],
      "protocol": "tcp",
      "ports": "443"
    },
    {
      "action": "allow",
      "process": "/Applications/Arq.app/Contents/Resources/ArqAgent.app/Contents/MacOS/ArqAgent",
      "remote-domains": "me.com",
      "protocol": "tcp",
      "ports": "587"
    },
    {
      "action": "allow",
      "process": "/Applications/Arq.app/Contents/Resources/ArqAgent.app/Contents/MacOS/ArqAgent",
      "remote-domains": [
        "1drv.com",
        "amazonaws.com",
        "arqbackup.com",
        "backblaze.com",
        "backblazeb2.com",
        "dropboxapi.com",
        "github.com",
        "microsoft.com",
        "microsoftonline.com",
        "onedrive.com"
      ],
      "protocol": "tcp",
      "ports": "443"
    },
    {
      "action": "allow",
      "process": "identifier.48ZCSDVL96/com.haystacksoftware.ArqAgent",
      "remote-hosts": "github.com",
      "protocol": "tcp",
      "ports": "443",
      "via": "path.opt/homebrew/Cellar/git-lfs/*/bin/git-lfs"
    },
    {
      "action": "allow",
      "process": "identifier.48ZCSDVL96/com.haystacksoftware.ArqAgent",
      "remote-hosts": "github.com",
      "protocol": "tcp",
      "ports": "443",
      "via": "path.opt/homebrew/Cellar/git/*/libexec/git-core/git-remote-http"
    }
  ]
}
